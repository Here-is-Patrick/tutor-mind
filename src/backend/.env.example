# ═══════════════════════════════════════════════════════════════
# TutorMind — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# cp .env.example .env

# ── Aliyun Bailian (DashScope) ───────────────────────────────
# Get your API key from: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-41cfcce889b6467eaefaba90077b4c75
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM model: qwen-turbo | qwen-plus | qwen-max
LLM_MODEL=qwen-plus

# Embedding model: text-embedding-v2 | text-embedding-v3
EMBEDDING_MODEL=text-embedding-v2

# ── Tavily Search ────────────────────────────────────────────
# Get your API key from: https://app.tavily.com/
TAVILY_API_KEY=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

# ── Application ──────────────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── ChromaDB ────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=qa_embeddings

# ── SQLite ───────────────────────────────────────────────────
SQLITE_PATH=./data/tutor_mind.db

# ── Retrieval ────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.75
TOP_K_RETRIEVAL=3

# ── Conversation ─────────────────────────────────────────────
MAX_SHORT_TERM_MESSAGES=20

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]